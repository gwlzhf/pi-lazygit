{
  "name": "pi-lazygit",
  "version": "0.1.1",
  "description": "Review project files and Git diffs inside Oh My Pi",
  "type": "module",
  "private": true,
  "files": [
    "src/contracts.ts",
    "src/filesystem.ts",
    "src/index.ts",
    "src/review-source.ts",
    "src/git/process.ts",
    "src/git/repository.ts",
    "src/git/status.ts",
    "src/model/baseline.ts",
    "src/model/tree.ts",
    "src/ui/files-panel.ts",
    "src/ui/render.ts"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.0.11 <19",
    "@oh-my-pi/pi-tui": ">=18.0.11 <19"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.0.11",
    "@oh-my-pi/pi-tui": "18.0.11",
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
